# Weather Dashboard Backend Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=mysql+pymysql://root:password@localhost/weather_dashboard

# ============================================================================
# Gemini AI Configuration
# ============================================================================

# Your Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Options: gemini-2.5-flash (latest), gemini-2.5-pro, gemini-2.0-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# Gemini API timeout in seconds (default: 30)
GEMINI_TIMEOUT=30

# ============================================================================
# FastAPI Configuration
# ============================================================================
PORT=8000
HOST=0.0.0.0

# ============================================================================
# Optional: Logging Configuration
# ============================================================================
# LOG_LEVEL=INFO
